<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <OutputType>Library</OutputType>
    <RootNamespace>LiquidMorph.Addin</RootNamespace>
    <AssemblyName>LiquidMorph.Desktop</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <DebugType>none</DebugType>
    <PlatformTarget>x64</PlatformTarget>
    <ComVisible>true</ComVisible>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="office">
      <HintPath>C:\Windows\assembly\GAC_MSIL\office\15.0.0.0__71e9bce111e9429c\OFFICE.DLL</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Extensibility">
      <HintPath>C:\Windows\assembly\GAC\Extensibility\7.0.3300.0__b03f5f7f11d50a3a\extensibility.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="RibbonActions.cs" />
    <Compile Include="Connect.cs" />
    <Compile Include="GlassOptions.cs" />
    <Compile Include="GlassOptionsStore.cs" />
    <Compile Include="GlassPipeline.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Icons\*.png"><LogicalName>Icons.%(Filename).png</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="Ribbon.xml">
      <LogicalName>LiquidMorph.Addin.Ribbon.xml</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>

